# Stage62 cancro public-XNU target identity scaffold
#
# This is deliberately declarative. Stage62 validates public source references
# and records the cancro/MSM8974 ARMv7 target boundary; it does not mutate the
# ignored external/ checkouts and it does not try to build a full mach_kernel.

STAGE62_TARGET := cancro
STAGE62_ARCH := armv7
STAGE62_CPU := cortex-a15
STAGE62_MACHINE := msm8974
STAGE62_PLATFORM := xiaomi-mi4-cancro

STAGE62_XNU_BASELINE := xnu-2050.22.13
STAGE62_XNU_BASELINE_COMMIT := cc8a9b0ce917bb7115f5c97a78b38db871557db0
STAGE62_XNU_MASTER_VERSION := 12.3.0
STAGE62_ARM_REFERENCE := xnu-4570.1.46

STAGE62_PUBLIC_ONLY := 1
STAGE62_NO_FULL_MACH_KERNEL := 1
STAGE62_NO_XNU_EXECUTION := 1
STAGE62_NO_PUBLIC_XNU_EXECUTION := 1
STAGE62_NO_EXTERNAL_MUTATION := 1
STAGE62_STAGE62_OBJECT_PLAN := targets/cancro.stage62.objects
STAGE62_OBJECT_SUBSET_COMPILE := 1
STAGE62_OBJECT_SUBSET_OUTPUT_DIR := out/stage62/xnu-objects
STAGE62_CONTROLLED_PUBLIC_XNU_LINK_PROOF := 1
STAGE62_XNU_LINK_OUTPUT_DIR := out/stage62/xnu-link
STAGE62_PEXPERT_PLATFORM_GRAPH := 1
STAGE62_ARM_PE_BOOTARGS_OBJECT := 1
STAGE62_ARM_PE_CONSISTENT_DEBUG_OBJECT := 1
STAGE62_ARM_PE_CONSISTENT_DEBUG_RUNTIME := 0
STAGE62_NO_PLATFORM_RUNTIME_EXECUTION := 1
STAGE62_DUPLICATE_SYMBOLS_CLOSED := 1
STAGE62_NO_MACHO_EXECUTION := 1
