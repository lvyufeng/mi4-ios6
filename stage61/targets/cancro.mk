# Stage61 cancro public-XNU target identity scaffold
#
# This is deliberately declarative. Stage61 validates public source references
# and records the cancro/MSM8974 ARMv7 target boundary; it does not mutate the
# ignored external/ checkouts and it does not try to build a full mach_kernel.

STAGE61_TARGET := cancro
STAGE61_ARCH := armv7
STAGE61_CPU := cortex-a15
STAGE61_MACHINE := msm8974
STAGE61_PLATFORM := xiaomi-mi4-cancro

STAGE61_XNU_BASELINE := xnu-2050.22.13
STAGE61_XNU_BASELINE_COMMIT := cc8a9b0ce917bb7115f5c97a78b38db871557db0
STAGE61_XNU_MASTER_VERSION := 12.3.0
STAGE61_ARM_REFERENCE := xnu-4570.1.46

STAGE61_PUBLIC_ONLY := 1
STAGE61_NO_FULL_MACH_KERNEL := 1
STAGE61_NO_XNU_EXECUTION := 1
STAGE61_NO_PUBLIC_XNU_EXECUTION := 1
STAGE61_NO_EXTERNAL_MUTATION := 1
STAGE61_STAGE61_OBJECT_PLAN := targets/cancro.stage61.objects
STAGE61_OBJECT_SUBSET_COMPILE := 1
STAGE61_OBJECT_SUBSET_OUTPUT_DIR := out/stage61/xnu-objects
STAGE61_CONTROLLED_PUBLIC_XNU_LINK_PROOF := 1
STAGE61_XNU_LINK_OUTPUT_DIR := out/stage61/xnu-link
STAGE61_PEXPERT_PLATFORM_GRAPH := 1
STAGE61_ARM_PE_BOOTARGS_OBJECT := 1
STAGE61_ARM_PE_CONSISTENT_DEBUG_OBJECT := 1
STAGE61_ARM_PE_CONSISTENT_DEBUG_RUNTIME := 0
STAGE61_NO_PLATFORM_RUNTIME_EXECUTION := 1
STAGE61_DUPLICATE_SYMBOLS_CLOSED := 1
STAGE61_NO_MACHO_EXECUTION := 1
