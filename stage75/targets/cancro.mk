# Stage75 cancro public-XNU target identity scaffold
#
# This is deliberately declarative. Stage75 validates public source references
# and records the cancro/MSM8974 ARMv7 target boundary; it does not mutate the
# ignored external/ checkouts and it does not try to build a full mach_kernel.

STAGE75_TARGET := cancro
STAGE75_ARCH := armv7
STAGE75_CPU := cortex-a15
STAGE75_MACHINE := msm8974
STAGE75_PLATFORM := xiaomi-mi4-cancro

STAGE75_XNU_BASELINE := xnu-2050.22.13
STAGE75_XNU_BASELINE_COMMIT := cc8a9b0ce917bb7115f5c97a78b38db871557db0
STAGE75_XNU_MASTER_VERSION := 12.3.0
STAGE75_ARM_REFERENCE := xnu-4570.1.46

STAGE75_PUBLIC_ONLY := 1
STAGE75_NO_FULL_MACH_KERNEL := 1
STAGE75_NO_XNU_EXECUTION := 1
STAGE75_NO_PUBLIC_XNU_EXECUTION := 1
STAGE75_NO_EXTERNAL_MUTATION := 1
STAGE75_STAGE75_OBJECT_PLAN := targets/cancro.stage75.objects
STAGE75_OBJECT_SUBSET_COMPILE := 1
STAGE75_OBJECT_SUBSET_OUTPUT_DIR := out/stage75/xnu-objects
STAGE75_CONTROLLED_PUBLIC_XNU_LINK_PROOF := 1
STAGE75_XNU_LINK_OUTPUT_DIR := out/stage75/xnu-link
STAGE75_PEXPERT_PLATFORM_GRAPH := 1
STAGE75_ARM_PE_BOOTARGS_OBJECT := 1
STAGE75_ARM_PE_CONSISTENT_DEBUG_OBJECT := 1
STAGE75_ARM_PE_CONSISTENT_DEBUG_RUNTIME := 0
STAGE75_NO_PLATFORM_RUNTIME_EXECUTION := 1
STAGE75_DUPLICATE_SYMBOLS_CLOSED := 1
STAGE75_NO_MACHO_EXECUTION := 1
