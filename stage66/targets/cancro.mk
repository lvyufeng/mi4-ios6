# Stage66 cancro public-XNU target identity scaffold
#
# This is deliberately declarative. Stage66 validates public source references
# and records the cancro/MSM8974 ARMv7 target boundary; it does not mutate the
# ignored external/ checkouts and it does not try to build a full mach_kernel.

STAGE66_TARGET := cancro
STAGE66_ARCH := armv7
STAGE66_CPU := cortex-a15
STAGE66_MACHINE := msm8974
STAGE66_PLATFORM := xiaomi-mi4-cancro

STAGE66_XNU_BASELINE := xnu-2050.22.13
STAGE66_XNU_BASELINE_COMMIT := cc8a9b0ce917bb7115f5c97a78b38db871557db0
STAGE66_XNU_MASTER_VERSION := 12.3.0
STAGE66_ARM_REFERENCE := xnu-4570.1.46

STAGE66_PUBLIC_ONLY := 1
STAGE66_NO_FULL_MACH_KERNEL := 1
STAGE66_NO_XNU_EXECUTION := 1
STAGE66_NO_PUBLIC_XNU_EXECUTION := 1
STAGE66_NO_EXTERNAL_MUTATION := 1
STAGE66_STAGE66_OBJECT_PLAN := targets/cancro.stage66.objects
STAGE66_OBJECT_SUBSET_COMPILE := 1
STAGE66_OBJECT_SUBSET_OUTPUT_DIR := out/stage66/xnu-objects
STAGE66_CONTROLLED_PUBLIC_XNU_LINK_PROOF := 1
STAGE66_XNU_LINK_OUTPUT_DIR := out/stage66/xnu-link
STAGE66_PEXPERT_PLATFORM_GRAPH := 1
STAGE66_ARM_PE_BOOTARGS_OBJECT := 1
STAGE66_ARM_PE_CONSISTENT_DEBUG_OBJECT := 1
STAGE66_ARM_PE_CONSISTENT_DEBUG_RUNTIME := 0
STAGE66_NO_PLATFORM_RUNTIME_EXECUTION := 1
STAGE66_DUPLICATE_SYMBOLS_CLOSED := 1
STAGE66_NO_MACHO_EXECUTION := 1
