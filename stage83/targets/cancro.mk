# Stage83 cancro public-XNU target identity scaffold
#
# This is deliberately declarative. Stage83 validates public source references
# and records the cancro/MSM8974 ARMv7 target boundary; it does not mutate the
# ignored external/ checkouts and it does not try to build a full mach_kernel.

STAGE83_TARGET := cancro
STAGE83_ARCH := armv7
STAGE83_CPU := cortex-a15
STAGE83_MACHINE := msm8974
STAGE83_PLATFORM := xiaomi-mi4-cancro

STAGE83_XNU_BASELINE := xnu-2050.22.13
STAGE83_XNU_BASELINE_COMMIT := cc8a9b0ce917bb7115f5c97a78b38db871557db0
STAGE83_XNU_MASTER_VERSION := 12.3.0
STAGE83_ARM_REFERENCE := xnu-4570.1.46

STAGE83_PUBLIC_ONLY := 1
STAGE83_NO_FULL_MACH_KERNEL := 1
STAGE83_NO_XNU_EXECUTION := 1
STAGE83_NO_PUBLIC_XNU_EXECUTION := 1
STAGE83_NO_EXTERNAL_MUTATION := 1
STAGE83_STAGE83_OBJECT_PLAN := targets/cancro.stage83.objects
STAGE83_OBJECT_SUBSET_COMPILE := 1
STAGE83_OBJECT_SUBSET_OUTPUT_DIR := out/stage83/xnu-objects
STAGE83_CONTROLLED_PUBLIC_XNU_LINK_PROOF := 1
STAGE83_XNU_LINK_OUTPUT_DIR := out/stage83/xnu-link
STAGE83_PEXPERT_PLATFORM_GRAPH := 1
STAGE83_ARM_PE_BOOTARGS_OBJECT := 1
STAGE83_ARM_PE_CONSISTENT_DEBUG_OBJECT := 1
STAGE83_ARM_PE_CONSISTENT_DEBUG_RUNTIME := 0
STAGE83_NO_PLATFORM_RUNTIME_EXECUTION := 1
STAGE83_DUPLICATE_SYMBOLS_CLOSED := 1
STAGE83_NO_MACHO_EXECUTION := 1
