# Stage78 cancro public-XNU target identity scaffold
#
# This is deliberately declarative. Stage78 validates public source references
# and records the cancro/MSM8974 ARMv7 target boundary; it does not mutate the
# ignored external/ checkouts and it does not try to build a full mach_kernel.

STAGE78_TARGET := cancro
STAGE78_ARCH := armv7
STAGE78_CPU := cortex-a15
STAGE78_MACHINE := msm8974
STAGE78_PLATFORM := xiaomi-mi4-cancro

STAGE78_XNU_BASELINE := xnu-2050.22.13
STAGE78_XNU_BASELINE_COMMIT := cc8a9b0ce917bb7115f5c97a78b38db871557db0
STAGE78_XNU_MASTER_VERSION := 12.3.0
STAGE78_ARM_REFERENCE := xnu-4570.1.46

STAGE78_PUBLIC_ONLY := 1
STAGE78_NO_FULL_MACH_KERNEL := 1
STAGE78_NO_XNU_EXECUTION := 1
STAGE78_NO_PUBLIC_XNU_EXECUTION := 1
STAGE78_NO_EXTERNAL_MUTATION := 1
STAGE78_STAGE78_OBJECT_PLAN := targets/cancro.stage78.objects
STAGE78_OBJECT_SUBSET_COMPILE := 1
STAGE78_OBJECT_SUBSET_OUTPUT_DIR := out/stage78/xnu-objects
STAGE78_CONTROLLED_PUBLIC_XNU_LINK_PROOF := 1
STAGE78_XNU_LINK_OUTPUT_DIR := out/stage78/xnu-link
STAGE78_PEXPERT_PLATFORM_GRAPH := 1
STAGE78_ARM_PE_BOOTARGS_OBJECT := 1
STAGE78_ARM_PE_CONSISTENT_DEBUG_OBJECT := 1
STAGE78_ARM_PE_CONSISTENT_DEBUG_RUNTIME := 0
STAGE78_NO_PLATFORM_RUNTIME_EXECUTION := 1
STAGE78_DUPLICATE_SYMBOLS_CLOSED := 1
STAGE78_NO_MACHO_EXECUTION := 1
