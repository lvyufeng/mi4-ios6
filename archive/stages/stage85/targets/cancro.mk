# Stage85 cancro public-XNU target identity scaffold
#
# This is deliberately declarative. Stage85 validates public source references
# and records the cancro/MSM8974 ARMv7 target boundary; it does not mutate the
# ignored external/ checkouts and it does not try to build a full mach_kernel.

STAGE85_TARGET := cancro
STAGE85_ARCH := armv7
STAGE85_CPU := cortex-a15
STAGE85_MACHINE := msm8974
STAGE85_PLATFORM := xiaomi-mi4-cancro

STAGE85_XNU_BASELINE := xnu-2050.22.13
STAGE85_XNU_BASELINE_COMMIT := cc8a9b0ce917bb7115f5c97a78b38db871557db0
STAGE85_XNU_MASTER_VERSION := 12.3.0
STAGE85_ARM_REFERENCE := xnu-4570.1.46

STAGE85_PUBLIC_ONLY := 1
STAGE85_NO_FULL_MACH_KERNEL := 1
STAGE85_NO_XNU_EXECUTION := 1
STAGE85_NO_PUBLIC_XNU_EXECUTION := 1
STAGE85_NO_EXTERNAL_MUTATION := 1
STAGE85_STAGE85_OBJECT_PLAN := targets/cancro.stage85.objects
STAGE85_OBJECT_SUBSET_COMPILE := 1
STAGE85_OBJECT_SUBSET_OUTPUT_DIR := out/stage85/xnu-objects
STAGE85_CONTROLLED_PUBLIC_XNU_LINK_PROOF := 1
STAGE85_XNU_LINK_OUTPUT_DIR := out/stage85/xnu-link
STAGE85_PEXPERT_PLATFORM_GRAPH := 1
STAGE85_ARM_PE_BOOTARGS_OBJECT := 1
STAGE85_ARM_PE_CONSISTENT_DEBUG_OBJECT := 1
STAGE85_ARM_PE_CONSISTENT_DEBUG_RUNTIME := 0
STAGE85_NO_PLATFORM_RUNTIME_EXECUTION := 1
STAGE85_DUPLICATE_SYMBOLS_CLOSED := 1
STAGE85_NO_MACHO_EXECUTION := 1
