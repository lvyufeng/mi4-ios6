# Stage76 cancro public-XNU target identity scaffold
#
# This is deliberately declarative. Stage76 validates public source references
# and records the cancro/MSM8974 ARMv7 target boundary; it does not mutate the
# ignored external/ checkouts and it does not try to build a full mach_kernel.

STAGE76_TARGET := cancro
STAGE76_ARCH := armv7
STAGE76_CPU := cortex-a15
STAGE76_MACHINE := msm8974
STAGE76_PLATFORM := xiaomi-mi4-cancro

STAGE76_XNU_BASELINE := xnu-2050.22.13
STAGE76_XNU_BASELINE_COMMIT := cc8a9b0ce917bb7115f5c97a78b38db871557db0
STAGE76_XNU_MASTER_VERSION := 12.3.0
STAGE76_ARM_REFERENCE := xnu-4570.1.46

STAGE76_PUBLIC_ONLY := 1
STAGE76_NO_FULL_MACH_KERNEL := 1
STAGE76_NO_XNU_EXECUTION := 1
STAGE76_NO_PUBLIC_XNU_EXECUTION := 1
STAGE76_NO_EXTERNAL_MUTATION := 1
STAGE76_STAGE76_OBJECT_PLAN := targets/cancro.stage76.objects
STAGE76_OBJECT_SUBSET_COMPILE := 1
STAGE76_OBJECT_SUBSET_OUTPUT_DIR := out/stage76/xnu-objects
STAGE76_CONTROLLED_PUBLIC_XNU_LINK_PROOF := 1
STAGE76_XNU_LINK_OUTPUT_DIR := out/stage76/xnu-link
STAGE76_PEXPERT_PLATFORM_GRAPH := 1
STAGE76_ARM_PE_BOOTARGS_OBJECT := 1
STAGE76_ARM_PE_CONSISTENT_DEBUG_OBJECT := 1
STAGE76_ARM_PE_CONSISTENT_DEBUG_RUNTIME := 0
STAGE76_NO_PLATFORM_RUNTIME_EXECUTION := 1
STAGE76_DUPLICATE_SYMBOLS_CLOSED := 1
STAGE76_NO_MACHO_EXECUTION := 1
